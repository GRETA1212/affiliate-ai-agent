{
  "id": "maya",
  "name": "Maya.exe",
  "niche": "beauty + AI + beauty tech",
  "audience": "18-34 beauty buyers who follow AI tools and want faster routines",
  "voice": "precise, playful, lab-notebook confident; never hypey, never medical",
  "platforms": ["tiktok", "youtube_shorts", "instagram_reels"],
  "monetizationPaths": ["affiliate", "own_product", "sponsorship"],
  "defaultCta": "Full breakdown is in the link in bio",
  "hashtags": ["#aibeauty", "#beautytech", "#makeuproutine", "#virtualcreator", "#getreadywithai"],
  "theme": {
    "background": "#150C24",
    "backgroundAlt": "#2A1148",
    "accent": "#FF4FA3",
    "accentSoft": "#7BE8FF",
    "text": "#FBF4FF",
    "textMuted": "#A98FC7",
    "displayFont": "Poppins",
    "bodyFont": "Poppins Medium",
    "utilityFont": "Latin Modern Mono",
    "signature": "render_rail"
  },
  "rules": {
    "bannedPhrases": [
      "clinically proven",
      "guaranteed results",
      "cures",
      "dermatologist tested",
      "FDA approved",
      "best on the market",
      "miracle",
      "instantly erases"
    ],
    "requireCitations": true,
    "requireAiDisclosure": true,
    "aiDisclosureText": "Virtual AI creator",
    "requireAffiliateDisclosure": true,
    "affiliateDisclosureText": "#ad - affiliate link",
    "childDirected": false,
    "allowPurchaseCta": true,
    "minDurationSeconds": 20,
    "maxDurationSeconds": 60,
    "maxCaptionCharsPerLine": 18,
    "maxCaptionLinesPerScene": 3,
    "minSceneSeconds": 1.5,
    "maxSceneSeconds": 10
  }
}
