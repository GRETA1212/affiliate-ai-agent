# ---------------------------------------------------------------------------
# media-factory environment template
# Copy to .env  ->  cp .env.example .env
# NEVER commit .env. The factory runs fully offline on the mock provider.
# ---------------------------------------------------------------------------

# Which LLM provider the agents use: mock | anthropic | openai | ollama
# "mock" is deterministic, free, offline, and is what the test suite uses.
LLM_PROVIDER=mock

# Optional. Only read when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional. Only read when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Only read when LLM_PROVIDER=ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Renderer: auto | remotion | fallback
# auto = try Remotion, fall back to the ffmpeg rasterizer if the headless
# browser is unavailable (offline / restricted CI).
RENDERER=auto

# Where rendered artifacts land
OUTPUT_DIR=./output
DATA_DIR=./data
