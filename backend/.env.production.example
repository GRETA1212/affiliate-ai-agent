# Public tracking origin used by website CTA generation and operator output.
AFFILIATE_TRACKING_BASE_URL=https://go.example.com

# Enable affiliate CTAs in the static website only after approval.
HOSTINGER_HORIZONS_AFFILIATE_ENABLED=0

# Paste the approved Hostinger affiliate tracking URL here after approval.
# Do not use a REFERRALCODE link, hPanel URL, or private Horizons project URL.
HOSTINGER_HORIZONS_AFFILIATE_URL=

# Persistent SQLite location for a single-server deployment.
AFFILIATE_DB_PATH=/var/lib/affiliate-ai/affiliate.db

# Network sync stays off unless credentials are configured and this is explicitly enabled.
AFFILIATE_ENABLE_NETWORK_SYNC=0

# Maya.exe TikTok publisher. Start in draft mode until the TikTok developer app
# has the required Content Posting API permissions and public Direct Post audit.
TIKTOK_ACCESS_TOKEN=
TIKTOK_PUBLISH_MODE=draft
